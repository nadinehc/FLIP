+class UniversalNoisePoisoner(Poisoner):
+    """Adds a fixed universal perturbation (learned by the GAN) to a PIL image.
+
+    `delta_path` is a .npy array of shape (H, W, 3) in pixel units, e.g. values in
+    [-6, 6] for eps = 6/255. Same mechanics as StripePoisoner: add, clip, uint8.
+    """
+    def __init__(self, *, delta_path="noise_generator/universal_delta.npy"):
+        self.delta_path = delta_path
+        self.delta = np.load(delta_path).astype(np.float32)
+
+    def poison(self, x: Image.Image) -> Image.Image:
+        arr = np.asarray(x).astype(np.float32)
+        assert arr.shape == self.delta.shape, f"{arr.shape} vs {self.delta.shape}"
+        mix = arr + self.delta
+        return Image.fromarray(np.uint8(np.round(mix).clip(0, 255)))
+
